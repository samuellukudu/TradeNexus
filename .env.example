# AI Studio Project Environment Variables
# Copy this file to .env or .env.local and fill in your values.

# The Google Gemini API key required for AI-powered autonomous features.
# Note: For strict client-side local development in Vite, you must prefix with VITE_ 
# unless your environment explicitly passes process.env to the frontend.
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# (Optional) Override the default Gemini model used for text generation
VITE_GEMINI_DEFAULT_MODEL=gemma-4-31b-it

# (Optional) Override the Gemini model used for tools like Google Maps grounding
VITE_GEMINI_GROUNDING_MODEL=gemma-4-31b-it

# Note on Firebase Configuration:
# Firebase config is managed directly in `firebase-applet-config.json` 
# when working within AI Studio or via the standard project setup.
