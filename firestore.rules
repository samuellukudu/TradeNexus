rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'createdAt', 'name', 'config']) &&
             data.userId == request.auth.uid &&
             data.userId is string &&
             data.createdAt is number &&
             data.name is string && data.name.size() <= 200 &&
             data.config is map;
    }

    function isValidSupplierProfile(data) {
      return data.keys().hasAll(['userId', 'companyName']) &&
             data.userId == request.auth.uid &&
             data.userId is string &&
             data.companyName is string &&
             data.companyName.size() <= 200;
    }

    match /users/{userId}/sessions/{sessionId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       isValidId(userId) && isValidId(sessionId) &&
                       isValidSession(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId &&
                       isValidId(userId) && isValidId(sessionId) &&
                       isValidSession(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(sessionId);
    }

    match /users/{userId}/profile/{profileId} {
      allow get: if isSignedIn() && request.auth.uid == userId && profileId == "supplier";
      allow create, update: if isSignedIn() && request.auth.uid == userId &&
                              profileId == "supplier" &&
                              isValidSupplierProfile(incoming());
    }
  }
}
